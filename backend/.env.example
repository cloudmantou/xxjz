NODE_ENV=development
PORT=9090
APP_PUBLIC_BASE_URL=https://xx.cloudmantoua.top

# Supported values: postgres, mysql, json, memory
RULES_STORAGE=postgres

# Postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/wuyoushu_rules

# MySQL
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=wuyoushu_rules

ENABLE_ENCRYPTION=false
AES_KEY=your-16byte-key!!
AES_IV=your-16byte-iv!!!

API_KEY=wuyoushu-api-key-2024
SIGN_SECRET=wuyoushu-sign-secret
ADMIN_PANEL_TOKEN=replace-with-strong-admin-token
USAGE_ANALYTICS_MAX_EVENTS=5000
